{
  "name": "serrugrams",
  "version": "0.1.0",
  "type": "module",
  "description": "Diagramas de sistemas sobre Excalidraw: explorador de carpeta, links entre diagramas, comentarios y MCP para agentes.",
  "bin": {
    "serrugrams": "./bin/serrugrams.js"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "dev": "node scripts/copy-fonts.mjs && concurrently -k -n server,web \"node --watch server/index.ts --dev\" \"vite\"",
    "build": "node scripts/clean.mjs && node scripts/copy-fonts.mjs && vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node server/index.ts",
    "mcp": "node server/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
